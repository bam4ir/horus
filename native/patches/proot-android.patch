 static uint64_t next_vpid = 1;
 
+/* Read host IDs, including non-leader TIDs which /proc does not enumerate. */
+static bool read_child_ids(pid_t pid, int *tgid, int *ppid, int *tracer)
+{
+	char path[64];
+	char line[256];
+	FILE *file;
+
+	*tgid = *ppid = *tracer = -1;
+	snprintf(path, sizeof(path), "/proc/%d/status", pid);
+	file = fopen(path, "r");
+	if (file == NULL)
+		return false;
+	while (fgets(line, sizeof(line), file) != NULL) {
+		if (sscanf(line, "Tgid: %d", tgid) == 1
+		    || sscanf(line, "PPid: %d", ppid) == 1
+		    || sscanf(line, "TracerPid: %d", tracer) == 1)
+			continue;
+	}
+	fclose(file);
+	return *tgid > 0 && *ppid >= 0 && *tracer >= 0;
+}
+
+/*
+ * True once new_child() has set up @pid. Do not use get_tracee(): even a
+ * lookup flushes the tracee's ctx.
+ */
+static bool is_initialized_child(pid_t pid)
+{
+	Tracee *known;
+
+	LIST_FOREACH(known, &tracees, link)
+		if (known->pid == pid)
+			break;
+	return known != NULL && (known->exe != NULL || known->parent != NULL
+		|| known->sigstop != SIGSTOP_PENDING || known->terminated);
+}
+
+/*
+ * Android may withhold GETEVENTMSG. Recover an uninitialized child owned by
+ * this tracer, using host parent/thread-group relationships. A child's
+ * SIGSTOP can precede the parent's event: its pending Tracee must be reused
+ * so new_child() can inherit configuration and restart it.
+ *
+ * PID order cannot identify the event child (PIDs wrap and threads race),
+ * so a fork needs a unique candidate. Threads are interchangeable: they
+ * share the parent's memory and inherit the same PRoot state, and each one
+ * brings its own clone event, so adopting any of them now still sets up
+ * every thread exactly once. A thread pool that starts several workers at
+ * once (x264, for one) would otherwise kill the whole session.
+ */
+static pid_t find_uninitialized_child(const Tracee *parent, word_t clone_flags)
+{
+	char path[64];
+	DIR *proc;
+	struct dirent *entry;
+	pid_t found = -ESRCH;
+	int parent_tgid, parent_ppid, parent_tracer;
+	bool thread = (clone_flags & CLONE_THREAD) != 0;
+
+	if (!read_child_ids(parent->pid, &parent_tgid, &parent_ppid, &parent_tracer)
+	    || parent_tracer != getpid())
+		return -ESRCH;
+
+	if (thread)
+		snprintf(path, sizeof(path), "/proc/%d/task", parent->pid);
+	else
+		snprintf(path, sizeof(path), "/proc");
+	proc = opendir(path);
+	if (proc == NULL)
+		return -errno;
+
+	while ((entry = readdir(proc)) != NULL) {
+		char *end;
+		long candidate;
+		int tgid, ppid, tracer;
+
+		errno = 0;
+		candidate = strtol(entry->d_name, &end, 10);
+		if (errno != 0 || end == entry->d_name || *end != '\0'
+		    || candidate <= 0 || candidate > INT_MAX
+		    || candidate == parent->pid)
+			continue;
+
+		if (is_initialized_child((pid_t) candidate))
+			continue;
+		if (!read_child_ids((pid_t) candidate, &tgid, &ppid, &tracer)
+		    || tracer != getpid())
+			continue;
+		if (thread ? tgid != parent_tgid
+		    : (tgid != candidate || ppid != ((clone_flags & CLONE_PARENT)
+			? parent_ppid : parent_tgid)))
+			continue;
+
+		if (found > 0 && !thread) {
+			found = -EAGAIN;
+			break;
+		}
+		if (found <= 0)
+			found = (pid_t) candidate;
+	}
+
+	(void) closedir(proc);
+
+	return found;
+}
