new file mode 100644
index 0000000..b19d8f9
--- /dev/null
+++ b/src/tracee/exit_status.h
@@ -0,0 +1,27 @@
+/* Preserve the initial guest process status independently of helper children. */
+#ifndef PROOT_EXIT_STATUS_H
+#define PROOT_EXIT_STATUS_H
+#include <stdint.h>
+#include <sys/wait.h>
+
+typedef struct {
+    int last_child;
+    int initial_guest;
+} ProotExitStatus;
+
+static inline void record_proot_exit_status(ProotExitStatus *state, uint64_t vpid, int status)
+{
+    if (WIFEXITED(status)) {
+        state->last_child = WEXITSTATUS(status);
+        if (vpid == 1)
+            state->initial_guest = state->last_child;
+    } else if (WIFSIGNALED(status) && vpid == 1) {
+        state->initial_guest = 128 + WTERMSIG(status);
+    }
+}
+
+static inline int get_proot_exit_status(const ProotExitStatus *state)
+{
+    return state->initial_guest >= 0 ? state->initial_guest : state->last_child;
+}
+#endif
